# The deploy workflow writes .env from GitHub Secrets/Variables.
# For a local run: cp .env.example .env and fill in the keys.

# required (GitHub Secrets)
RUSTFS_ACCESS_KEY=change-me
RUSTFS_SECRET_KEY=change-me-to-a-long-random-string

# optional (GitHub Variables)
DTLK_PORT=8780
DTLK_ADMIN_PORT=8781
DTLK_PUBLIC_URL=https://dtlk.ga111o.com
# IP of the nginx server; X-Forwarded-For is trusted only from here
DTLK_TRUSTED_PROXY_IPS=127.0.0.1
DTLK_TZ=Asia/Seoul
# client version (`dtlk -v`); the deploy workflow sets yymmdd-<commit>
DTLK_VERSION=dev
